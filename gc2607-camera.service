# Template — the installed unit is generated by gc2607-setup-service.sh
# with correct paths for your system. Do not install this file directly.
#
# Lifecycle across suspend/resume is handled by
# /usr/lib/systemd/system-sleep/gc2607 (pre stops, post starts).
# Do NOT use Conflicts=sleep.target — it makes systemd refuse the
# post-resume start with a 'destructive transaction' error while
# systemd-suspend.service is still finishing.

[Unit]
Description=GC2607 Camera Virtual Webcam
After=multi-user.target graphical.target
Wants=multi-user.target

[Service]
Type=simple
ExecStart=/opt/gc2607/gc2607-service.sh
ExecStartPost=/opt/gc2607/gc2607-restart-wireplumber.sh
# Sensor orientation: none | hflip (default) | rot180
# Environment=GC2607_ROTATION=none
Restart=on-abnormal
RestartSec=5
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
